	(text "K-LINE TRANSCEIVER (pinout checked: ST DS1765 Rev 7)\nL9637D: TX/RX non-inverting (firmware: no TX inversion)\nVCC = 3.3V from ESP32: logic matches GPIO, no level shifter\nJP1: bridge LI to VS (L-line unused, keeps LO high / low quiescent)"
		(exclude_from_sim no)
		(at 121.92 30.48 0)
